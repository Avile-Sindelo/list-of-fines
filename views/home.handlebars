<div class="container">
    <form action="/filtered" method="POST">
        <select name="option">
            <option disabled selected> Choose a title</option>
            {{#each keywords}}
                <option value={{this}}> {{this}} </option>
            {{/each}}
        </select>
    
        <button type="submit">Search</button>
    </form>

    <table>
        <thead>
            <tr>
                <th>Charge Code</th>
                <th>Legislation</th>
                <th>Charge wording</th>
                <th>Classification of offence, infringement</th>
                <th>Penalty units</th>
                <th>Demerit points</th>
                <th>Penalty in Rand value</th>
                <th>Penalty minus discount in Rand value</th>
                <th>Operator charge/Jusristic person who is not an operator charge </th>
            </tr>
        </thead>
        <tbody>
            {{#each fines}}
               <tr>
                    <td>{{charge_code}}</td>
                    <td>{{legislation}}</td>
                    <td>{{charge_wording}}</td>
                    <td>{{offence_or_infringement}}</td>
                    <td>{{penalty_units}}</td>
                    <td>{{demerit_points}}</td>
                    <td>{{amount}}</td>
                    <td>{{discounted_amount}}</td>
                    <td>{{operator_charge}}</td>
               </tr>
            {{/each}}
        </tbody>
    </table>
 
</div>

